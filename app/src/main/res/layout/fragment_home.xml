<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_scrollFlags="scroll|exitUntilCollapsed">

            <!-- New Header Layout -->
            <include layout="@layout/layout_home_header" />

            <!-- Sync In-Progress Active Indicator -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress_home_sync"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="?attr/colorPrimary"
                app:trackColor="@android:color/transparent" />

            <!-- Stats Cards (Attendance & OD) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_stats_carousel"
                android:layout_width="match_parent"
                android:layout_height="124dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="12dp"
                android:clipToPadding="false"
                android:overScrollMode="never" />

        </LinearLayout>

        <!-- Days Tab Layout (Segmented Pill Bar) -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_layout_days"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:padding="3dp"
            android:background="@drawable/bg_days_segmented_bar"
            app:tabBackground="@null"
            app:tabIndicator="@drawable/bg_day_tab_indicator"
            app:tabIndicatorColor="?attr/colorPrimary"
            app:tabIndicatorFullWidth="true"
            app:tabIndicatorGravity="center"
            app:tabIndicatorHeight="36dp"
            app:tabIndicatorAnimationMode="elastic"
            app:tabMode="fixed"
            app:tabGravity="fill"
            app:tabMaxWidth="0dp"
            app:tabMinWidth="0dp"
            app:tabPaddingStart="0dp"
            app:tabPaddingEnd="0dp"
            app:tabPaddingTop="0dp"
            app:tabPaddingBottom="0dp"
            app:tabRippleColor="@android:color/transparent"
            app:tabSelectedTextColor="?attr/colorOnPrimary"
            app:tabTextColor="?attr/colorOnSurfaceVariant"
            app:tabTextAppearance="@style/TextAppearance.VTOP.DayTab" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager_timetable"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
