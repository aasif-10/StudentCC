<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activities.MainActivity">

    <!-- Fragment container -->
    <FrameLayout
        android:id="@+id/frame_layout_fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Modern floating pill bottom navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_pill_nav"
        android:elevation="10dp"
        app:elevation="0dp"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_navigation"
        app:itemIconTint="@color/selector_navigation_icon"
        app:itemTextColor="@color/selector_navigation_text"
        app:itemActiveIndicatorStyle="@style/Widget.App.NavActiveIndicator"
        app:indicatorColor="@color/nav_active_indicator"
        app:itemIconSize="22dp"
        app:itemPaddingTop="8dp"
        app:itemPaddingBottom="8dp"
        app:itemTextAppearanceActive="@style/TextAppearance.App.BottomNav"
        app:itemTextAppearanceInactive="@style/TextAppearance.App.BottomNav" />

</RelativeLayout>
